{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Commercial appliance, smart home device, electronics or digital ebook item listed in the marketplace",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product identifier",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Product display title",
          "maxLength": 200,
          "minLength": 2
        },
        "sellerId": {
          "type": "string",
          "description": "Unique UID of the authenticated merchant seller who owns this product",
          "maxLength": 128
        },
        "seller_id": {
          "type": "string",
          "description": "Unique UID of the authenticated merchant seller who owns this product (snake_case alias)",
          "maxLength": 128
        },
        "sellerName": {
          "type": "string",
          "description": "Store or seller merchant brand name",
          "maxLength": 100
        },
        "brand": {
          "type": "string",
          "description": "Manufacturer or publisher brand",
          "maxLength": 100
        },
        "categoryId": {
          "type": "string",
          "description": "Category identifier",
          "maxLength": 100
        },
        "price": {
          "type": "number",
          "description": "Item price in base currency (USD)"
        },
        "stock": {
          "type": "number",
          "description": "Current available inventory units"
        },
        "status": {
          "type": "string",
          "description": "Publication state",
          "enum": ["active", "out_of_stock", "draft", "deleted"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 modification timestamp"
        }
      },
      "required": ["id", "title", "sellerId", "price"]
    },
    "SellerConfig": {
      "title": "SellerConfig",
      "description": "Global merchant configuration settings for payout thresholds and fees",
      "type": "object",
      "properties": {
        "settlementPeriodHours": { "type": "number" },
        "minWithdrawalAmount": { "type": "number" },
        "autoPayoutEnabled": { "type": "boolean" },
        "platformFeePercent": { "type": "number" }
      }
    },
    "SellerPayout": {
      "title": "SellerPayout",
      "description": "Seller payout withdrawal request and disbursement record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "amountNGN": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Review": {
      "title": "Review",
      "description": "Customer product ratings and feedback commentary stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "customerId": { "type": "string" },
        "uid": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "verifiedPurchase": { "type": "boolean" },
        "helpfulCount": { "type": "number" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "customerId", "rating", "comment"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Global catalog of marketplace products visible to all shoppers, manageable strictly by the owning seller or platform admins"
    },
    "/reviews/{reviewId}": {
      "schema": {
        "$ref": "#/entities/Review"
      },
      "description": "Customer ratings and reviews on marketplace catalog products"
    },
    "/system_configs/{configId}": {
      "schema": {
        "$ref": "#/entities/SellerConfig"
      },
      "description": "System wide merchant and platform fee configurations"
    },
    "/seller_payouts/{payoutId}": {
      "schema": {
        "$ref": "#/entities/SellerPayout"
      },
      "description": "Historical records and requests for merchant seller earnings payouts"
    }
  }
}
